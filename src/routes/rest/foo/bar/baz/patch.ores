import module telemetry from "../../../../../lib/telemetry";
import module store from "../../../../../lib/store";

define isoactor Handler as
  receive(ActorMail<String> mail): void {
    val request = http.claim(mail.value);
    val span = telemetry.actor_started(rt borrow request, "isolated");
    let int telemetry_status = 0;
    try {
      request.set_header("X-Route-File", "src/routes/rest/foo/bar/baz/patch.ores");
      if request.header("Content-Type") != "text/plain"; then
        await request.respond(415, "text/plain", "send Content-Type: text/plain");
        telemetry_status = 415;
        self.end();
        return;
      fi
      val String body = await request.body_text();
      if body == ""; then
        await request.respond(400, "text/plain", "body must not be empty");
        telemetry_status = 400;
        self.end();
        return;
      fi

      val bool exists = await store.exists();
      if !exists; then
        await request.respond(404, "text/plain", "resource not found");
        telemetry_status = 404;
        self.end();
        return;
      fi

      // Bound the existing representation before reading it into actor state.
      val int current_bytes = await store.size();
      if current_bytes > store.max_resource_bytes(); then
        await request.respond(413, "text/plain", "existing resource exceeds persisted byte quota");
        telemetry_status = 413;
        self.end();
        return;
      fi

      val String current = await store.read();
      val String updated = current + body;

      // UTF-8 byte quota, not character count. The staging file is safe here
      // because server admission is one exchange through actor finalization.
      await store.stage_for_size(updated);
      val int updated_bytes = await store.staged_size();
      await store.clear_stage();
      if updated_bytes > store.max_resource_bytes(); then
        await request.respond(413, "text/plain", "resource exceeds persisted byte quota");
        telemetry_status = 413;
        self.end();
        return;
      fi

      await store.write(updated);
      await request.respond(200, "text/plain; charset=utf-8", updated);
      telemetry_status = 200;
      self.end();
      return;
    } catch (failure) {
      span.event("ERROR", "handler failed");
      if request.can_respond; then
        await request.respond(500, "text/plain", "Internal Server Error");
        telemetry_status = 500;
      fi
      self.end();
      return;
    } finally {
      span.finish(telemetry_status == 0 || telemetry_status >= 500 ? "error" : "ok", telemetry_status);
    }
  }
end

define module route as
  pub fnc handler(): HttpHandler { return http.handler("Handler"); }
end
